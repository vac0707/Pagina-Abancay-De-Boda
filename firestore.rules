rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vacstudio7@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Global Studio Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dynamic Pages Content
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Portfolio Items
    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stories Items
    match /stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Packages Items
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FAQ Items
    match /faq/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media Library
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inquiries (public can submit, admin can read/write)
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.name is string;
      allow read, update, delete: if isAdmin();
    }

  }
}
